# Public values required by Supabase Auth in browser/server session helpers.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Server only. Never prefix these with NEXT_PUBLIC_ or ship them to browser code.
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
WEBHOOK_SECRET=<shared-webhook-secret>

# Google Sheets zone sources and OAuth credentials (server only).
SHEET_ISD=<spreadsheet-id>
SHEET_OSD=<spreadsheet-id>
SHEET_CTG=<spreadsheet-id>
GOOGLE_OAUTH_CLIENT_ID=<oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<oauth-client-secret>
GOOGLE_OAUTH_REFRESH_TOKEN=<oauth-refresh-token>
